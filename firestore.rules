rules_version = '2';

// Diabeatis360 Firestore security rules (audited/written 2026-09-25, follows docs/FIRESTORE_SCHEMA.md
// "Security rules plan" and the decisions D8 and D9 in docs/DECISIONS.md).
//
// How to read this file: every `allow` line has a one-line "why" comment above it, so each rule can be
// defended in front of the panel. Anything not matched below is DENIED by default (no catch-all).
//
// Role model (D9): the app screens are chosen from Users.role, but these rules NEVER trust Users.role
// (a user can edit their own doc). Authority comes from documents only an admin can create or change:
//   Admins/{uid}                 -> admin
//   Providers/{uid}.is_verified  -> a doctor whose PRC credentials an admin verified
// Email confirmation (D21) is NOT a document either: it is the email_verified claim inside the signed sign-in token,
// so nobody can mark themselves confirmed. Booking, chat, video calls and a doctor's access to patient data all
// need it. Creating a profile document does not (the admin panel's "Add Provider" creates a doctor's profile before
// that doctor has had any chance to open an email), and an admin still approves every doctor's credentials.
//
// Booking privacy (D22): a booking can be read only by its patient, its doctor and admins. The booking screen greys out
// taken times from Booked_Slots (a doctor, a time, taken or not; no patient information). A doctor reads a patient's
// profile and blood sugar readings only through Care_Links, a share the patient makes by booking that doctor. The doctor's
// written summary lives in Consultation_Notes, readable by the two people on the booking only.
//
// Reported consultations (D58): when the patient or the doctor on a booking reports the other, an admin may read THAT
// booking's chat and consultation notes to investigate, after recording that they opened it (Admin_Access_Log). No other
// chat is ever readable by an admin.
//
// KNOWN LIMITATIONS (be upfront about these in the defense):
//   1. A doctor keeps seeing a patient's profile and readings after a CONSULTATION ENDS, until the patient removes the
//      share (the rules allow it; the app has no button for it yet). A declined or cancelled booking removes it at once.
//   2. Points, streaks and badges are written by the app, so a patient could award themselves points (no health data at
//      risk; the AI limits and Premium are enforced elsewhere, D20).
//   3. Doctors must be verified (Providers/{uid}.is_verified == true) to read patient data. The admin panel's Verify
//      Credentials action sets it.
//   4. Every rule is covered by the Firestore emulator suite (npm run test:rules, all passing). After deploying, still
//      try one flow per role in the Rules Playground and in the app.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers

    // True when the caller is signed in (every collection below needs this).
    function signedIn() {
      return request.auth != null;
    }

    // True when the caller is the person whose Auth UID equals `uid`.
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // An admin is anyone with a document in Admins/ (only created by the seed script, never from a client).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/Admins/$(request.auth.uid));
    }

    // True when the caller has CONFIRMED their email address (DECISIONS.md D21). Firebase puts email_verified inside the
    // signed sign-in token, so neither the app nor a person editing a Firestore field can fake it. The token is renewed
    // when the app sees the person tapped the link in their email; until then it can say "no" for up to an hour.
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // A doctor whose credentials an admin verified, who is still active, and whose own email address is confirmed
    // (so patient health data is never readable by a doctor nobody could reach by email).
    function isVerifiedDoctor() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/Providers/$(request.auth.uid))
        && get(/databases/$(database)/documents/Providers/$(request.auth.uid)).data.get('is_verified', false) == true
        && get(/databases/$(database)/documents/Providers/$(request.auth.uid)).data.get('is_active', true) == true;
    }

    // The fields a write actually changes (used to allow "only these fields" updates).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The booking with this id (used by chat and notification rules to check "are you in this booking?").
    function bookingData(bookingId) {
      return get(/databases/$(database)/documents/Bookings/$(bookingId)).data;
    }

    // ---- booking privacy (DECISIONS.md D22)

    // A booking that still holds its time slot and still lets its doctor see the patient: waiting for the doctor,
    // accepted, or finished. A declined or cancelled booking holds nothing.
    function isLiveBooking(status) {
      return status in ['pending', 'confirmed', 'completed'];
    }

    // The Booked_Slots document for a booking's doctor and time. Its id is built from the booking's data by these rules
    // (the app does not get to choose it), so two bookings for the same doctor and time always meet at the same document,
    // whatever ids those bookings have.
    function slotPathFor(data) {
      return /databases/$(database)/documents/Booked_Slots/$(data.provider_id + '_' + string(data.scheduled_at.toMillis()));
    }

    // The Care_Links document through which one patient lets one doctor see their profile and blood sugar readings.
    function careLinkPath(providerId, patientId) {
      return /databases/$(database)/documents/Care_Links/$(providerId + '_' + patientId);
    }

    // True when the caller is a doctor who may see this patient's profile and readings: admin-verified, active, with a
    // confirmed email, AND the patient shared them with this doctor (a Care_Links document, made when the patient booked).
    function canSeePatient(patientId) {
      return isVerifiedDoctor() && exists(careLinkPath(request.auth.uid, patientId));
    }

    // A pediatric account (D16): the account's own Users doc says so, and its Guardian_Verifications doc
    // (same id as the account) must have been approved by an admin. exists() first because a brand-new
    // 'self' account never gets a Guardian_Verifications document at all.
    function isUnapprovedMinor() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('account_type', 'self') == 'minor'
        && !(exists(/databases/$(database)/documents/Guardian_Verifications/$(request.auth.uid))
             && get(/databases/$(database)/documents/Guardian_Verifications/$(request.auth.uid)).data.get('verification_status', 'pending') == 'approved');
    }

    // A well-formed new booking (also used to re-book a slot freed by a decline/cancel): by the caller for
    // themselves, pending and unpaid, fee copied from the doctor's profile, commission = fee x 0.15 (D3).
    // A pediatric account (D16) may not book until its guardian verification is approved, and nobody books before
    // confirming their email address (D21).
    // The same write must also take the time slot and share the patient's profile with the doctor (D22): a booking cannot
    // exist without its Booked_Slots and Care_Links documents, which have their own rules below.
    function validNewBooking(bookingId) {
      return verifiedEmail()
        && request.resource.data.patient_id == request.auth.uid
        && !isUnapprovedMinor()
        && request.resource.data.status == 'pending'
        && request.resource.data.payment_status == 'unpaid'
        && request.resource.data.fee == get(/databases/$(database)/documents/Providers/$(request.resource.data.provider_id)).data.get('consultation_fee', 0)
        && request.resource.data.platform_commission is number
        && math.abs(request.resource.data.platform_commission - request.resource.data.fee * 0.15) < 0.01
        // D47: a doctor whose wallet is below 0 (commission owed on on-site payments) cannot be booked until they top up.
        // The balance is written only by the server (functions/lib/wallet.js); a doctor with no wallet yet is at 0.
        && (!exists(/databases/$(database)/documents/Wallets/$(request.resource.data.provider_id))
            || get(/databases/$(database)/documents/Wallets/$(request.resource.data.provider_id)).data.get('balance', 0) >= 0)
        && request.resource.data.scheduled_at is timestamp
        // D26: only a time that has not started yet, by the SERVER's clock (request.time), so a wrong phone clock cannot
        // book the past. Philippine time does not matter here: both sides are exact moments.
        && request.resource.data.scheduled_at > request.time
        // Only the fields the app writes (D24 added the patient's optional "concern", at most 300 characters). Without
        // this list a patient could add any field, for example a fake decline reason.
        && request.resource.data.keys().hasOnly(['patient_id', 'provider_id', 'status', 'scheduled_at', 'fee', 'platform_commission',
                                                 'payment_status', 'payment_method', 'queue_number', 'created_at', 'concern'])
        && request.resource.data.get('concern', '') is string
        && request.resource.data.get('concern', '').size() <= 300
        && existsAfter(slotPathFor(request.resource.data))
        && getAfter(slotPathFor(request.resource.data)).data.booking_id == bookingId
        && getAfter(slotPathFor(request.resource.data)).data.active == true
        && existsAfter(careLinkPath(request.resource.data.provider_id, request.auth.uid))
        && getAfter(careLinkPath(request.resource.data.provider_id, request.auth.uid)).data.booking_id == bookingId;
    }

    // After a change to an EXISTING booking, its Booked_Slots document must say "taken" exactly while the booking is live
    // (D22): a decline or cancellation frees the slot in the same write, and nothing can free a live booking's slot.
    function slotInStep(bookingId) {
      return existsAfter(slotPathFor(request.resource.data))
        && getAfter(slotPathFor(request.resource.data)).data.booking_id == bookingId
        && getAfter(slotPathFor(request.resource.data)).data.active == isLiveBooking(request.resource.data.status);
    }

    // True when the caller is the patient or the doctor of the given booking.
    function inBooking(bookingId) {
      return signedIn()
        && (bookingData(bookingId).patient_id == request.auth.uid
            || bookingData(bookingId).provider_id == request.auth.uid);
    }

    // ---- admin review of a reported consultation (DECISIONS.md D58)

    // The id of the conduct report one person on a booking filed about the other: "<bookingId>_<reporterId>". The Reports
    // rules force this id, so these rules can find a report without searching the collection.
    function conductReportId(bookingId, reporterId) {
      return bookingId + '_' + reporterId;
    }

    // True when the caller is an admin who may read this booking's chat and consultation notes. That needs an
    // Admin_Access_Log record of this admin opening it, and that record can only be made after the patient or the doctor
    // on the booking reported the other. So an admin never reads a chat nobody reported, and never without a record.
    function adminMayReview(bookingId) {
      return isAdmin()
        && exists(/databases/$(database)/documents/Admin_Access_Log/$(bookingId + '_' + request.auth.uid));
    }

    // A well-formed new video call (D11): started by a person in a CONFIRMED booking, ringing the OTHER person on it,
    // who has confirmed their own email address (D21).
    function validNewCall(bookingId) {
      return verifiedEmail()
        && inBooking(bookingId)
        && request.resource.data.booking_id == bookingId
        && request.resource.data.caller_id == request.auth.uid
        && request.resource.data.callee_id != request.auth.uid
        && request.resource.data.callee_id in [bookingData(bookingId).patient_id, bookingData(bookingId).provider_id]
        && request.resource.data.status == 'ringing'
        && request.resource.data.room is string
        && request.resource.data.room.size() >= 16
        && bookingData(bookingId).status == 'confirmed';
    }

    // A well-formed new subscription (module 12, DECISIONS.md D20). Premium is a demo purchase (payment is mocked, D5), but
    // its TERMS are not the app's to choose, because the AI server reads these documents to decide who is Premium:
    //  - a real PAID plan from Subscription_Plans (no Free plan, no made-up plan id, no "/" to point somewhere else);
    //  - started_at is the SERVER's clock (the app sends serverTimestamp()), so a start date cannot be backdated;
    //  - expires_at is start + that plan's length, give or take one day for a phone clock that is a little off, so a
    //    year-2099 expiry means no unlimited Premium;
    //  - expires_at must exist: the server treats a missing expiry as "Premium forever";
    //  - exactly these fields and nothing else, and it starts 'active' (cancelling is a separate update below).
    function validNewSubscription() {
      let data = request.resource.data;
      let plan = get(/databases/$(database)/documents/Subscription_Plans/$(data.plan_id)).data;
      let planLength = duration.value(int(plan.get('duration_days', 0)), 'd');
      return signedIn()
        && data.keys().hasOnly(['user_id', 'plan_id', 'status', 'started_at', 'expires_at', 'created_at'])
        && data.keys().hasAll(['user_id', 'plan_id', 'status', 'started_at', 'expires_at'])
        && data.user_id == request.auth.uid
        && data.status == 'active'
        && data.plan_id is string && data.plan_id.size() > 0 && !data.plan_id.matches('.*/.*')
        && plan.get('price', 0) > 0
        && plan.get('duration_days', 0) > 0
        && data.started_at == request.time
        && data.expires_at is timestamp
        && data.expires_at >= request.time + planLength - duration.value(1, 'd')
        && data.expires_at <= request.time + planLength + duration.value(1, 'd');
    }

    // ------------------------------------------------------------------ accounts

    match /Users/{userId} {
      // Health fields (DECISIONS.md D25): when one is written it must be a value the app itself offers, so a stray
      // 'Pre-Diabetic', an empty allergy list or a birthdate saved as text can never land in a profile again.
      // allergies is free text from the person; 'None' is how someone says they have none, so it cannot be empty.
      // D40: the diets are Everything and Vegetarian (an old 'No Pork' or 'Diabetic Diet' stays readable but cannot be
      // written again), and disliked_ingredients is free text like allergies, where '' means none.
      function okHealth(data, keys) {
        return (!keys.hasAny(['diabetes_type']) || data.diabetes_type in ['Type 1', 'Type 2', 'Prediabetes'])
          && (!keys.hasAny(['allergies']) || (data.allergies is string && data.allergies.size() >= 1 && data.allergies.size() <= 500))
          && (!keys.hasAny(['birthdate']) || okBirthdate(data))
          && (!keys.hasAny(['activity_level']) || data.activity_level in ['Sedentary', 'Light', 'Active', 'Very Active'])
          && (!keys.hasAny(['dietary_preference']) || data.dietary_preference in ['Everything', 'Vegetarian'])
          && (!keys.hasAny(['disliked_ingredients']) || (data.disliked_ingredients is string && data.disliked_ingredients.size() <= 300));
      }
      // A birthdate (QA PAT-001) is a date (D25), not in the future, and it fits the account (D16): an account "for me" is
      // 18 or older, a child's account is under 18 (no account_type means "for me", as on accounts made before D16).
      // 18 years is 6574 or 6575 days, depending on leap days. These rules allow two days either way, because the app
      // stores the person's own midnight and the rules count days on the server's clock; the app checks the exact
      // birthday first (constants/guardian.ts birthdateProblem).
      function okBirthdate(data) {
        return data.birthdate is timestamp
          && data.birthdate <= request.time
          && (data.get('account_type', 'self') == 'minor'
                ? data.birthdate > request.time - duration.value(6576, 'd')
                : data.birthdate <= request.time - duration.value(6573, 'd'));
      }
      // A doctor's mobile number (My Profile, D49): '' (none) or the one stored form +639XXXXXXXXX. On Users, not
      // Providers, so patients never read it.
      function okPhone(data, keys) {
        return !keys.hasAny(['phone_number'])
          || (data.phone_number is string && (data.phone_number == '' || data.phone_number.matches('^[+]639[0-9]{9}$')));
      }
      // A child's account (D16) keeps a copy of its guardian's name and relationship (never the ID photo) so that a doctor
      // the child booked can see who runs the account (QA DOC-013 part 2): a doctor can read this Users doc (canSeePatient)
      // but not Guardian_Verifications. The copy may only be written on a 'minor' account, and only equal to the
      // Guardian_Verifications document as it stands after the same write (the app saves both in one batch), so it
      // can never say something the admin did not review.
      function okGuardianCopy(data, keys) {
        return !keys.hasAny(['guardian_full_name', 'guardian_relationship'])
          || (data.get('account_type', 'self') == 'minor'
              && existsAfter(/databases/$(database)/documents/Guardian_Verifications/$(userId))
              && data.get('guardian_full_name', '') == getAfter(/databases/$(database)/documents/Guardian_Verifications/$(userId)).data.guardian_full_name
              && data.get('guardian_relationship', '') == getAfter(/databases/$(database)/documents/Guardian_Verifications/$(userId)).data.relationship_to_minor);
      }
      // A person reads their own profile; admins manage users; a doctor reads only the profiles of patients who shared
      // them by booking that doctor (Care_Links, D22), not every patient's.
      allow read: if isUser(userId) || isAdmin() || canSeePatient(userId);
      // You can only create your own profile, and cannot create it already deactivated. account_type (D16),
      // if present, must be 'self' or 'minor' — anything else is rejected outright, not silently ignored.
      allow create: if isUser(userId) && request.resource.data.get('is_active', true) == true
                    && request.resource.data.get('account_type', 'self') in ['self', 'minor']
                    && okHealth(request.resource.data, request.resource.data.keys())
                    && okPhone(request.resource.data, request.resource.data.keys())
                    && okGuardianCopy(request.resource.data, request.resource.data.keys());
      // Owners edit their own profile but cannot reactivate/deactivate themselves; only admins flip is_active.
      // account_type (D16) is set once — the Users doc already exists by the time onboarding chooses "For me" /
      // "For my child" (it is created earlier, at email verification), so this has to be an update, not a
      // create. It may only go from "never set" to a valid value; once set, it is fixed, so a minor account
      // cannot relabel itself 'self' later to dodge guardian approval.
      allow update: if isAdmin() && changedKeys().hasOnly(['is_active'])
                    || (isUser(userId) && !changedKeys().hasAny(['is_active'])
                        && okHealth(request.resource.data, changedKeys())
                        && okPhone(request.resource.data, changedKeys())
                        && okGuardianCopy(request.resource.data, changedKeys())
                        && (!changedKeys().hasAny(['account_type'])
                            || (!('account_type' in resource.data) && request.resource.data.account_type in ['self', 'minor'])));
      // Accounts are deactivated, never deleted, so history (bookings, logs) stays intact.
      allow delete: if false;
    }

    match /Providers/{providerId} {
      // The consultation fee (QA ADM-005), whenever it is written: a number from 0 to 20,000 pesos. 0 means "not set yet"
      // (a doctor who signs up has no fee, and Find a Doctor lists only fees above 0, so every screen that sets a fee asks
      // for more than 0). 20,000 is the ceiling of the app's fee screens (mobile constants/fees.ts, admin lib/fee.js):
      // change all three together. A patient's booking copies this fee, so a negative one would be negative revenue.
      function okFee(data, keys) {
        return !keys.hasAny(['consultation_fee'])
          || (data.consultation_fee is number && data.consultation_fee >= 0 && data.consultation_fee <= 20000);
      }
      // has_photo (D54) puts a doctor on Find a Doctor, so it may only say true when the doctor's Profile_Photos document
      // exists after the same write (the app saves both in one batch). A doctor cannot appear "with a photo" without one.
      function okPhotoFlag(data, keys) {
        return !keys.hasAny(['has_photo'])
          || (data.has_photo is bool
              && (data.has_photo == false || existsAfter(/databases/$(database)/documents/Profile_Photos/$(providerId))));
      }
      // The credentials after a doctor's name ("MD, FPCP", DECISIONS.md D55 part 1). Patients see only `credentials`,
      // and only an admin can give it a value: by approving exactly what the doctor asked for in `credentials_requested`.
      // Letters, spaces and . , ( ) - only, at most 60 characters (the app's own check is features/doctor/credentials.ts).
      function okCredentialText(value) {
        return value is string && value.size() <= 60 && (value == '' || value.matches('[A-Za-z][A-Za-z.,() -]*'));
      }
      // The doctor's side: ask for a suffix (or withdraw the request with ''), clear the admin's rejection reason when
      // asking again, and remove an approved suffix. The doctor can never put a new value in `credentials` itself.
      function okDoctorCredentials(data, keys) {
        return (!keys.hasAny(['credentials_requested']) || okCredentialText(data.credentials_requested))
          && (!keys.hasAny(['credentials']) || data.credentials == '')
          && (!keys.hasAny(['credentials_rejection_reason']) || data.credentials_rejection_reason == '');
      }
      // The admin's side: approve (credentials := the request, the request is cleared), reject with a reason (the request
      // stays, so the doctor sees what was refused), or remove a suffix that turns out to be false ('').
      function okAdminCredentials(keys) {
        return (!keys.hasAny(['credentials'])
                || request.resource.data.credentials == ''
                || request.resource.data.credentials == resource.data.get('credentials_requested', ''))
          && (!keys.hasAny(['credentials_requested']) || request.resource.data.credentials_requested == '')
          && (!keys.hasAny(['credentials_rejection_reason'])
              || (request.resource.data.credentials_rejection_reason is string && request.resource.data.credentials_rejection_reason.size() <= 500));
      }
      // Any signed-in user can browse the doctor directory (patients need it to book).
      allow read: if signedIn();
      // A doctor creates their own profile, but can never create it pre-verified or pre-approved, and can never
      // create it carrying any admin/audit field (verified_by, reviewed_by, reviewed_at, created_by_admin) —
      // otherwise a self-registered doctor could forge "an admin added me" in the audit trail. (The admin panel's
      // Add Provider writes this document as the new doctor, so the fee check covers it too.)
      allow create: if isUser(providerId)
                    && request.resource.data.get('is_verified', false) == false
                    && request.resource.data.get('is_active', true) == true
                    && !request.resource.data.keys().hasAny(['verified_by', 'reviewed_by', 'reviewed_at', 'created_by_admin', 'wallet_blocked'])
                    && okFee(request.resource.data, request.resource.data.keys())
                    && okPhotoFlag(request.resource.data, request.resource.data.keys())
                    && okDoctorCredentials(request.resource.data, request.resource.data.keys());
      // wallet_blocked (D47) is written only by the server, so a doctor cannot unblock themselves without topping up.
      // Doctors edit their profile/schedule but cannot verify/activate themselves or touch the admin review
      // trail; they MAY still clear rejection_reason themselves when they resubmit (module 10, admin Figma pass).
      // Admins may additionally reject with a reason and record who reviewed it; created_by_admin (UT-A006,
      // "Add Provider") can be set once, the same one-shot pattern Users.account_type uses (D16). When an admin
      // writes created_by_admin or reviewed_by the value must be THEIR OWN uid, so the field names which admin
      // account did it instead of being any string an admin chooses. verified_by is pinned the same way. The fee is checked
      // only when it changes, so a doctor with an old out-of-range fee can still edit their other fields.
      allow update: if (isUser(providerId) && !changedKeys().hasAny(['is_verified', 'verified_by', 'is_active', 'reviewed_by', 'reviewed_at', 'created_by_admin', 'wallet_blocked'])
                        && okFee(request.resource.data, changedKeys())
                        && okPhotoFlag(request.resource.data, changedKeys())
                        && okDoctorCredentials(request.resource.data, changedKeys()))
                    || (isAdmin() && changedKeys().hasOnly(['is_verified', 'verified_by', 'is_active', 'rejection_reason', 'reviewed_by', 'reviewed_at', 'created_by_admin',
                                                            'credentials', 'credentials_requested', 'credentials_rejection_reason'])
                        && okAdminCredentials(changedKeys())
                        && (!changedKeys().hasAny(['created_by_admin'])
                            || (!('created_by_admin' in resource.data) && request.resource.data.created_by_admin == request.auth.uid))
                        && (!changedKeys().hasAny(['reviewed_by']) || request.resource.data.reviewed_by == request.auth.uid)
                        && (!changedKeys().hasAny(['verified_by']) || request.resource.data.verified_by == request.auth.uid));
      // Doctors are deactivated, not deleted.
      allow delete: if false;
    }

    // Profile photos (DECISIONS.md D54). One small JPEG per person, saved as text, because Firebase Storage needs the
    // Blaze plan (D18). The document id IS the person's Auth UID. Kept apart from Users/Providers so the doctor
    // directory does not download every photo, and so a patient's photo has its own, narrower readers.
    match /Profile_Photos/{uid} {
      // A doctor's photo belongs to the doctor directory, so any signed-in user may see it (patients choosing a doctor).
      // A patient's photo is seen only by the patient, admins, and the doctors the patient shared their profile with
      // by booking them (Care_Links, D22) — the same people who may read that patient's Users document.
      allow read: if isUser(uid) || isAdmin()
                  || (signedIn() && exists(/databases/$(database)/documents/Providers/$(uid)))
                  || canSeePatient(uid);
      // Only the person sets their own photo: exactly these two fields, a JPEG "data:" address of at most 200,000
      // characters (about 150 KB; the app saves about 15-40 KB, photo-rules.ts), stamped with the server's clock.
      allow create, update: if isUser(uid)
                    && request.resource.data.keys().hasOnly(['photo', 'updated_at'])
                    && request.resource.data.photo is string
                    && request.resource.data.photo.size() <= 200000
                    && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
                    && request.resource.data.updated_at == request.time;
      // A patient may remove theirs (initials show again). A doctor can only replace it: patients must always be able
      // to recognise their doctor, and Providers.has_photo would otherwise point at a photo that is gone.
      allow delete: if isUser(uid) && !exists(/databases/$(database)/documents/Providers/$(uid));
    }

    match /Admins/{adminId} {
      // An admin can read only their own record (the admin app uses this to confirm the login is an admin).
      allow read: if isUser(adminId);
      // Admin accounts are created only by the seed script with the Admin SDK, never from an app.
      allow create, delete: if false;
      // An admin may update only their own display name and last-login time (Update Account); never their role.
      allow update: if isUser(adminId) && changedKeys().hasOnly(['full_name', 'last_login']);
    }

    // Pediatric account under guardian supervision (DECISIONS.md D16, manuscript UT-005). The document id IS
    // the child's own Auth UID (the manuscript's "Minor's Own User ID"), so there is exactly one per account.
    match /Guardian_Verifications/{childUid} {
      // Visible only to the child's own account (the guardian has no separate login) and to admins who review it.
      allow read: if isUser(childUid) || isAdmin();
      // First submission: the child's own account creates it, always starting pending, with the guardian's
      // name, relationship and ID photo filled in.
      allow create: if isUser(childUid)
        && request.resource.data.user_id == childUid
        && request.resource.data.verification_status == 'pending'
        && request.resource.data.guardian_full_name is string && request.resource.data.guardian_full_name.size() > 0
        && request.resource.data.relationship_to_minor in ['parent', 'legal_guardian', 'other']
        && request.resource.data.guardian_id_photo_url is string && request.resource.data.guardian_id_photo_url.size() > 0;
      allow update: if
        // Resubmitting after a rejection: a fresh guardian name/relationship/photo, back to pending, nothing else.
        (isUser(childUid)
          && resource.data.verification_status == 'rejected'
          && request.resource.data.user_id == childUid
          && request.resource.data.verification_status == 'pending'
          && request.resource.data.relationship_to_minor in ['parent', 'legal_guardian', 'other']
          && request.resource.data.guardian_full_name is string && request.resource.data.guardian_full_name.size() > 0
          && request.resource.data.guardian_id_photo_url is string && request.resource.data.guardian_id_photo_url.size() > 0
          && changedKeys().hasOnly(['guardian_full_name', 'relationship_to_minor', 'guardian_id_photo_url', 'verification_status', 'submitted_at', 'rejection_reason']))
        // Only an admin approves or rejects, and only by changing the review fields.
        || (isAdmin() && changedKeys().hasOnly(['verification_status', 'reviewed_by', 'reviewed_at', 'rejection_reason']));
      allow delete: if false;
    }

    // ------------------------------------------------------------------ blood sugar

    match /Glucose_Logs/{logId} {
      // A whole number a home meter can show, 20-600 mg/dL (DECISIONS.md D25, constants/glucose.ts READING_LIMITS).
      function possibleReading(data) {
        return data.reading_mgdl is int && data.reading_mgdl >= 20 && data.reading_mgdl <= 600;
      }
      // Readings are private health data: the patient, admins, and a doctor the patient shared them with by booking
      // that doctor (Care_Links, D22) only. A doctor's list query must name the patient (where patient_id ==).
      allow read: if signedIn() && (resource.data.patient_id == request.auth.uid || isAdmin() || canSeePatient(resource.data.patient_id));
      // When a reading was taken (QA DOC-012). The app dates it with the phone's clock, which may run a little fast, so it
      // may be at most 5 minutes past the server's clock (constants/glucose.ts READING_CLOCK_SKEW_MS says the same; change
      // both together). A later time would keep a reading "latest" for days and put it in tomorrow's chart and alerts. An
      // earlier time is fine: a reading kept on the phone while offline is sent when the connection returns.
      function okLoggedAt(data) {
        return data.logged_at is timestamp && data.logged_at <= request.time + duration.value(5, 'm');
      }
      // You can only log readings for yourself, and only a possible value. A new reading starts with no edits (D44).
      // created_at is the server's time of saving (the app sends serverTimestamp()), never the phone's: the family-SMS
      // server (D45) trusts it to accept only a reading saved in the last 30 minutes.
      allow create: if signedIn() && request.resource.data.patient_id == request.auth.uid
                    && possibleReading(request.resource.data)
                    && !('edit_count' in request.resource.data)
                    && okLoggedAt(request.resource.data)
                    && request.resource.data.created_at == request.time;
      // You can edit only your own readings, and only what the reading says: never whose it is or when it was taken.
      // Every change to the value, meal context or notes must add the next edit record in the same write (D44), so a
      // change can never skip the history. A save that changes none of those three must leave the edit count alone.
      allow update: if signedIn() && resource.data.patient_id == request.auth.uid
                    && possibleReading(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['reading_mgdl', 'context', 'notes', 'interpretation', 'edit_count'])
                    && (readingChanged()
                          ? request.resource.data.edit_count == resource.data.get('edit_count', 0) + 1
                            && existsAfter(editPath(logId, request.resource.data.edit_count))
                          : request.resource.data.get('edit_count', 0) == resource.data.get('edit_count', 0));
      // You can delete only your own readings (the app offers delete-with-confirmation, and deletes the edit records
      // in the same write).
      allow delete: if signedIn() && resource.data.patient_id == request.auth.uid;

      // True when this write changes what the reading says (the three things an edit record keeps).
      function readingChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['reading_mgdl', 'context', 'notes']);
      }
      function logPath(id) {
        return /databases/$(database)/documents/Glucose_Logs/$(id);
      }
      function editPath(id, number) {
        return /databases/$(database)/documents/Glucose_Logs/$(id)/Edits/$(string(number));
      }

      // A reading's edit history (D44): records 1, 2, 3… each holding the values before and after one change and the
      // server's time of it. Written only together with the change it describes, and never changed afterwards, so a
      // doctor can trust it: if 280 became 120, both numbers and the time stay on record.
      match /Edits/{editNumber} {
        // Exactly the people who can read the reading can read its history.
        allow read: if signedIn() && (get(logPath(logId)).data.patient_id == request.auth.uid
                                      || isAdmin()
                                      || canSeePatient(get(logPath(logId)).data.patient_id));
        // Only the reading's patient, only inside the edit it records: it is the next number, the reading's count moves
        // to that number in the same write, "before" is what the reading said until now (get), "after" is what it says
        // once this write is done (getAfter), and the time is the server's.
        allow create: if signedIn()
                      && get(logPath(logId)).data.patient_id == request.auth.uid
                      && editNumber == string(get(logPath(logId)).data.get('edit_count', 0) + 1)
                      && getAfter(logPath(logId)).data.get('edit_count', 0) == get(logPath(logId)).data.get('edit_count', 0) + 1
                      && request.resource.data.keys().hasOnly(['previous_reading_mgdl', 'previous_context', 'previous_notes',
                                                               'reading_mgdl', 'context', 'notes', 'edited_at'])
                      && request.resource.data.keys().hasAll(['previous_reading_mgdl', 'previous_context', 'previous_notes',
                                                              'reading_mgdl', 'context', 'notes', 'edited_at'])
                      && request.resource.data.previous_reading_mgdl == get(logPath(logId)).data.reading_mgdl
                      && request.resource.data.previous_context == get(logPath(logId)).data.get('context', 'before_meal')
                      && request.resource.data.previous_notes == get(logPath(logId)).data.get('notes', '')
                      && request.resource.data.reading_mgdl == getAfter(logPath(logId)).data.reading_mgdl
                      && request.resource.data.context == getAfter(logPath(logId)).data.get('context', 'before_meal')
                      && request.resource.data.notes == getAfter(logPath(logId)).data.get('notes', '')
                      && request.resource.data.edited_at == request.time;
        // A record is never changed. It can only be deleted in the same write that deletes its reading.
        allow update: if false;
        allow delete: if signedIn()
                      && get(logPath(logId)).data.patient_id == request.auth.uid
                      && !existsAfter(logPath(logId));
      }
    }

    // ------------------------------------------------------------------ appointments and chat

    match /Bookings/{bookingId} {
      // A booking is private (D22): only its patient, its doctor and admins can read it. Patients and doctors list their own
      // with where patient_id == / where provider_id ==. The booking screen no longer reads bookings to grey out taken
      // times: it reads Booked_Slots, which holds no patient information.
      allow read: if signedIn() && (resource.data.patient_id == request.auth.uid
                                    || resource.data.provider_id == request.auth.uid
                                    || isAdmin());

      // A patient creates a booking only for themselves, starting as pending and unpaid, the fee must equal the
      // doctor's listed fee (the patient cannot name their own price), and the platform commission must be 15%
      // of that fee (DECISIONS.md D3; a cent of rounding is tolerated). The same write takes the time slot
      // (Booked_Slots) and shares the profile with the doctor (Care_Links), see validNewBooking.
      allow create: if validNewBooking(bookingId);

      allow update: if signedIn() && (
        // A slot whose earlier booking was declined or cancelled can be booked again, by anyone, as a fresh
        // pending booking. An active booking (pending/confirmed/completed) can never be overwritten this way.
        (resource.data.status in ['declined', 'cancelled'] && validNewBooking(bookingId))
        // The booked doctor decides the request, orders the queue, and records the consultation outcome, nothing else.
        // (The written summary is its own document, Consultation_Notes.) A decline frees the slot in the same write.
        || (resource.data.provider_id == request.auth.uid
          && changedKeys().hasOnly(['status', 'queue_number', 'consultation_status', 'consultation_ended_at', 'consultation_ended_by', 'decline_reason'])
          // D24: a decline may carry the doctor's reason (shown to the patient), only with the decline, at most 500 characters.
          && (!changedKeys().hasAny(['decline_reason'])
              || (request.resource.data.status == 'declined'
                  && request.resource.data.decline_reason is string
                  && request.resource.data.decline_reason.size() <= 500))
          && slotInStep(bookingId))
        // The patient may end their own confirmed consultation (booking becomes completed; the doctor can add the
        // written summary afterwards in Consultation_Notes).
        || (resource.data.patient_id == request.auth.uid
          && resource.data.status == 'confirmed'
          && changedKeys().hasOnly(['status', 'consultation_status', 'consultation_ended_at', 'consultation_ended_by'])
          && request.resource.data.status == 'completed'
          && request.resource.data.consultation_status == 'ended'
          && request.resource.data.get('consultation_ended_by', '') == 'patient')
        // The patient may only pay, and only after the doctor confirmed and while still unpaid.
        || (resource.data.patient_id == request.auth.uid
          && resource.data.status == 'confirmed'
          && resource.data.payment_status == 'unpaid'
          && changedKeys().hasOnly(['payment_status', 'payment_method'])
          && request.resource.data.payment_status in ['paid', 'onsite'])
        // Either side of the booking may mark the consultation as started (first chat message opens it).
        || (inBooking(bookingId)
          && changedKeys().hasOnly(['consultation_status'])
          && request.resource.data.consultation_status == 'active')
        // The patient may cancel their own booking while it is still pending or confirmed; the slot is freed in the same write.
        || (resource.data.patient_id == request.auth.uid
          && resource.data.status in ['pending', 'confirmed']
          && changedKeys().hasOnly(['status', 'queue_number'])
          && request.resource.data.status == 'cancelled'
          && slotInStep(bookingId))
      );

      // Bookings are history (and revenue), so they are never deleted; cancel/decline instead.
      allow delete: if false;
    }

    // ------------------------------------------------------------------ the doctor's wallet (DECISIONS.md D47)
    // Demo money. Only the server (functions/lib/wallet.js, with the Admin SDK) changes a balance or adds a transaction,
    // so no app can give anyone money. A doctor reads their own wallet and history; admins read all of them.
    match /Wallets/{providerId} {
      allow read: if isUser(providerId) || isAdmin();
      allow write: if false;
    }
    match /Wallet_Transactions/{transactionId} {
      allow read: if signedIn() && (resource.data.provider_id == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // Where the doctor's withdrawals go (D47, "Payout account" on My Wallet). The DOCTOR writes it, since it moves no money:
    // the server only reads it to name the account on each withdrawal. Only the bank's name (from a fixed list, kept in
    // step with PAYOUT_BANKS in diabeatis360-mobile/src/features/wallet/payout.ts) or GCash, the holder's name and the
    // LAST 4 DIGITS are allowed, so a full account number can never be stored here. Patients cannot read it.
    match /Payout_Accounts/{providerId} {
      allow read: if isUser(providerId) || isAdmin();
      allow create, update: if isUser(providerId)
        && exists(/databases/$(database)/documents/Providers/$(providerId))
        && request.resource.data.keys().hasOnly(['kind', 'provider_name', 'account_name', 'last4', 'updated_at'])
        && request.resource.data.keys().hasAll(['kind', 'provider_name', 'account_name', 'last4', 'updated_at'])
        && ((request.resource.data.kind == 'gcash' && request.resource.data.provider_name == 'GCash')
            || (request.resource.data.kind == 'bank'
                && request.resource.data.provider_name in ['BDO', 'BPI', 'Metrobank', 'Land Bank', 'UnionBank', 'Security Bank', 'PNB', 'RCBC', 'China Bank']))
        && request.resource.data.account_name is string
        && request.resource.data.account_name.size() >= 2 && request.resource.data.account_name.size() <= 80
        && request.resource.data.last4 is string && request.resource.data.last4.matches('^[0-9]{4}$')
        && request.resource.data.updated_at == request.time;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ booked time slots (DECISIONS.md D22)
    // One document per doctor and time, id "<providerId>_<epoch milliseconds>", so the booking screen can grey out taken
    // times without anyone reading other people's bookings. It holds NO patient information: a doctor, a time and
    // whether it is taken. It is written only in the same write as the booking it belongs to, by that booking's patient or
    // doctor, and "taken" always matches the booking's status. A time that is taken can be freed by its own booking but
    // never taken over by another booking, so a slot cannot be double-booked even by an app that picks its own booking ids.
    match /Booked_Slots/{slotId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['provider_id', 'scheduled_at', 'booking_id', 'active'])
        && request.resource.data.keys().hasAll(['provider_id', 'scheduled_at', 'booking_id', 'active'])
        && request.resource.data.scheduled_at is timestamp
        && request.resource.data.provider_id is string
        && slotId == request.resource.data.provider_id + '_' + string(request.resource.data.scheduled_at.toMillis())
        && request.resource.data.booking_id is string
        && existsAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id))
        && getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.provider_id == request.resource.data.provider_id
        && getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.scheduled_at == request.resource.data.scheduled_at
        && (getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.patient_id == request.auth.uid
            || getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.provider_id == request.auth.uid)
        && request.resource.data.active == isLiveBooking(getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.status)
        && (
          // taking the time: it must be free (never booked, or freed by a decline or cancellation) ...
          (request.resource.data.active == true
            && (resource == null || resource.data.active == false || resource.data.booking_id == request.resource.data.booking_id))
          // ... freeing it: only by the booking that holds it
          || (request.resource.data.active == false && resource != null && resource.data.booking_id == request.resource.data.booking_id));
      allow delete: if false;
    }

    // ------------------------------------------------------------------ doctor access to a patient (DECISIONS.md D22)
    // "Care_Links/{providerId}_{patientId}": a patient shares their health profile and blood sugar readings with ONE doctor.
    // It is made by the patient in the same write as a booking request with that doctor (UT-023: a doctor sees only patients
    // who have a booking with them), and holds only ids. The patient can remove it at any time; the doctor can remove it once
    // the booking it points to has been declined or cancelled (the app does that in the same write as the decline).
    match /Care_Links/{linkId} {
      allow read: if signedIn() && (resource.data.patient_id == request.auth.uid
                                    || resource.data.provider_id == request.auth.uid
                                    || isAdmin());
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['provider_id', 'patient_id', 'booking_id', 'updated_at'])
        && request.resource.data.keys().hasAll(['provider_id', 'patient_id', 'booking_id', 'updated_at'])
        && request.resource.data.patient_id == request.auth.uid
        && request.resource.data.provider_id is string
        && linkId == request.resource.data.provider_id + '_' + request.auth.uid
        && request.resource.data.updated_at == request.time
        && request.resource.data.booking_id is string
        && existsAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id))
        && getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.patient_id == request.auth.uid
        && getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.provider_id == request.resource.data.provider_id
        && isLiveBooking(getAfter(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.status);
      allow delete: if signedIn() && (
        resource.data.patient_id == request.auth.uid
        || (resource.data.provider_id == request.auth.uid
            && existsAfter(/databases/$(database)/documents/Bookings/$(resource.data.booking_id))
            && !isLiveBooking(getAfter(/databases/$(database)/documents/Bookings/$(resource.data.booking_id)).data.status)));
    }

    // ------------------------------------------------------------------ the doctor's written summary (DECISIONS.md D22)
    // "Consultation_Notes/{bookingId}": what the doctor wrote when ending the consultation. It used to sit on the booking,
    // which many people could read; now only the two people on that booking can, and an admin investigating a report
    // about that consultation (D58: adminMayReview).
    match /Consultation_Notes/{bookingId} {
      allow read: if signedIn() && (inBooking(bookingId) || adminMayReview(bookingId));
      allow create, update: if verifiedEmail()
        && bookingData(bookingId).provider_id == request.auth.uid
        && bookingData(bookingId).status in ['confirmed', 'completed']
        // D24: the notes are "summary" (the Diagnosis notes), plus optional "advice" and a "follow_up_at" date (or null).
        && request.resource.data.keys().hasOnly(['booking_id', 'patient_id', 'provider_id', 'summary', 'advice', 'follow_up_at', 'updated_at'])
        && request.resource.data.keys().hasAll(['booking_id', 'patient_id', 'provider_id', 'summary', 'updated_at'])
        && request.resource.data.booking_id == bookingId
        && request.resource.data.patient_id == bookingData(bookingId).patient_id
        && request.resource.data.provider_id == request.auth.uid
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 5000
        && request.resource.data.get('advice', '') is string
        && request.resource.data.get('advice', '').size() <= 2000
        && (request.resource.data.get('follow_up_at', null) == null || request.resource.data.follow_up_at is timestamp)
        && request.resource.data.updated_at == request.time;
      allow delete: if false;
    }

    match /Messages/{messageId} {
      // Chat is private: only the patient and doctor of the booking the message belongs to can read it (D8), and an admin
      // investigating a report one of them filed about the other (D58: adminMayReview). Everyone's list query must name the
      // booking (where booking_id ==).
      allow read: if signedIn() && (inBooking(resource.data.booking_id) || adminMayReview(resource.data.booking_id));
      // You can send a message only as yourself, into your own booking, while it is confirmed (read-only once completed),
      // and only once your own email address is confirmed (D21).
      allow create: if verifiedEmail()
                    && request.resource.data.sender_id == request.auth.uid
                    && inBooking(request.resource.data.booking_id)
                    && bookingData(request.resource.data.booking_id).status == 'confirmed'
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    // A shared blood sugar trend (the chart in the chat): optional, a short list of daily averages.
                    && (!('trend' in request.resource.data)
                        || (request.resource.data.trend is list && request.resource.data.trend.size() <= 7));
      // Sent messages are a medical-consultation record, so they can be neither edited nor deleted.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ video calls (DECISIONS.md D11)
    // One document per booking, keyed by the booking id, describing the CURRENT call. Only the two people on the booking
    // can see or change it.
    match /Calls/{bookingId} {
      // Reading one call (the caller watching for an answer): allowed for anyone on that booking, even before a call exists.
      allow get: if inBooking(bookingId);
      // Watching for incoming calls is a query on callee_id, which must be the caller's own id.
      allow list: if signedIn() && (resource.data.callee_id == request.auth.uid || resource.data.caller_id == request.auth.uid);

      // Start a call: a fresh document.
      allow create: if validNewCall(bookingId);

      allow update: if signedIn() && (
        // Ring again after the previous call finished (declined, missed or ended); an active ringing/accepted call cannot be overwritten.
        (resource.data.status in ['declined', 'missed', 'ended'] && validNewCall(bookingId))
        // The person being called answers: accept or decline, nothing else.
        || (resource.data.callee_id == request.auth.uid && resource.data.status == 'ringing'
            && changedKeys().hasOnly(['status']) && request.resource.data.status in ['accepted', 'declined'])
        // The caller gives up (cancel) or the ring timed out (missed) while it is still ringing.
        || (resource.data.caller_id == request.auth.uid && resource.data.status == 'ringing'
            && changedKeys().hasOnly(['status', 'ended_at']) && request.resource.data.status in ['missed', 'ended'])
        // Either person hangs up an accepted call.
        || (resource.data.status == 'accepted' && (resource.data.caller_id == request.auth.uid || resource.data.callee_id == request.auth.uid)
            && changedKeys().hasOnly(['status', 'ended_at']) && request.resource.data.status == 'ended')
      );

      // Call records are never deleted.
      allow delete: if false;
    }

    // ------------------------------------------------------------------ notifications

    match /Notifications/{notificationId} {
      // You read only your own notifications; admins may read all (to review announcements).
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // You may notify yourself (glucose alerts), the other party of a booking you are in (booking updates,
      // chat messages, always tagged with that booking's id), or, as an admin, anyone (announcements).
      allow create: if signedIn() && request.resource.data.user_id is string && (
        request.resource.data.user_id == request.auth.uid
        || isAdmin()
        || (request.resource.data.get('related_id', '') != ''
            && inBooking(request.resource.data.related_id)
            && request.resource.data.user_id in [
                 bookingData(request.resource.data.related_id).patient_id,
                 bookingData(request.resource.data.related_id).provider_id ])
      );
      // The owner may only mark a notification as read; its text cannot be rewritten.
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
                    && changedKeys().hasOnly(['is_read']);
      allow delete: if false;
    }

    // ------------------------------------------------------------------ announcements (admin Figma pass)

    match /Announcements/{announcementId} {
      // History + drafts on the admin Settings page (fanned out to Notifications on publish, module 8).
      // Nobody outside the admin panel needs to read these, so — unlike most collections — this is admin-only.
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.title is string && request.resource.data.title.size() <= 200
                    && request.resource.data.message is string && request.resource.data.message.size() <= 1000
                    && request.resource.data.audience in ['all', 'patient', 'doctor']
                    && request.resource.data.status in ['draft', 'published']
                    && request.resource.data.created_by == request.auth.uid;
      allow update: if isAdmin()
                    && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
                    && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 1000))
                    && (!('audience' in request.resource.data) || request.resource.data.audience in ['all', 'patient', 'doctor'])
                    && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'published']);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------ reports (D51: "Report a problem", Table 31 #6)

    // A patient or doctor reports a problem with the app, or flags the other person on a booking they share; an admin
    // reviews it, replies, and marks it resolved. Nobody else can read a report, and nobody can delete one.
    match /Reports/{reportId} {
      // "Report this doctor" comes from the patient on that booking, "Report this patient" from its doctor, and the flagged
      // person must be the other one on it. This is what stops anyone flagging a stranger.
      function flagsTheOtherPerson(data) {
        return (data.category == 'doctor_conduct'
                  && bookingData(data.booking_id).patient_id == request.auth.uid
                  && bookingData(data.booking_id).provider_id == data.reported_user_id)
          || (data.category == 'patient_conduct'
                  && bookingData(data.booking_id).provider_id == request.auth.uid
                  && bookingData(data.booking_id).patient_id == data.reported_user_id);
      }
      function validNewReport(id, data) {
        return data.keys().hasOnly(['reporter_id', 'reporter_role', 'category', 'message', 'reported_user_id', 'booking_id', 'status', 'created_at'])
          && data.keys().hasAll(['reporter_id', 'reporter_role', 'category', 'message', 'status', 'created_at'])
          && data.reporter_id == request.auth.uid
          // Only a label for the admin's list; it must match the role on the reporter's own profile. A person who has not
          // confirmed their email has no profile yet (D21), so they count as a patient.
          && data.reporter_role in ['patient', 'doctor']
          && data.reporter_role == (exists(/databases/$(database)/documents/Users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('role', 'patient')
                : 'patient')
          && data.category in ['app_problem', 'payment', 'account', 'doctor_conduct', 'patient_conduct', 'other']
          && data.message is string && data.message.size() >= 10 && data.message.size() <= 1000
          && data.status == 'open'
          && data.created_at == request.time
          // A report about a person needs the booking that links you to them; every other category names nobody.
          && (data.category in ['doctor_conduct', 'patient_conduct']
                ? (data.reported_user_id is string && data.booking_id is string && flagsTheOtherPerson(data)
                   // D58: one conduct report per person per booking, filed under "<bookingId>_<reporterId>", which is what
                   // lets an admin open that booking's chat (Admin_Access_Log below).
                   && id == conductReportId(data.booking_id, request.auth.uid))
                // Any other report has an automatic id, which never contains "_". So nobody can take the id of a conduct
                // report somebody else has not filed yet (and stop them from reporting).
                : !('reported_user_id' in data) && !('booking_id' in data) && !id.matches('.*_.*'));
      }

      // The reporter sees their own reports (and the admin's reply); admins see all of them.
      allow read: if signedIn() && (resource.data.reporter_id == request.auth.uid || isAdmin());
      // Anyone signed in may report (even before confirming their email: "I never got the email" is a real problem).
      allow create: if signedIn() && validNewReport(reportId, request.resource.data);
      // status: open (the admin's turn) -> awaiting_reporter (the admin asked the reporter something, D59) -> resolved.
      allow update: if (
        // Only an admin moves a report between the three statuses and resolves it, under their own name. The report
        // itself cannot be rewritten. admin_reply is the single reply from before D59: the panel now writes
        // Report_Replies instead, and old reports keep theirs.
        (isAdmin()
          && changedKeys().hasOnly(['status', 'admin_reply', 'resolved_by', 'resolved_at'])
          && request.resource.data.status in ['open', 'awaiting_reporter', 'resolved']
          && request.resource.data.get('admin_reply', '') is string
          && request.resource.data.get('admin_reply', '').size() <= 1000
          && (!('resolved_by' in changedKeys()) || request.resource.data.resolved_by == request.auth.uid))
        // The reporter answers the admin's question, which puts the report back in the admin's Open list (D59). This is the
        // only change a reporter can make: never resolve, never reopen, never touch the text.
        || (signedIn() && resource.data.reporter_id == request.auth.uid
          && resource.data.status == 'awaiting_reporter'
          && changedKeys().hasOnly(['status'])
          && request.resource.data.status == 'open')
      );
      allow delete: if false;
    }

    // ------------------------------------------------------------------ report replies (D59)
    // The conversation on a report: an admin asks for details, the reporter answers, until the report is resolved.
    // A separate collection and not a list inside the report, for the same reason chat uses Messages: the rules can check
    // every message (who sent it, how long, the server's time), and a sent message can never be edited or deleted.
    match /Report_Replies/{replyId} {
      function reportOf(reportId) {
        return get(/databases/$(database)/documents/Reports/$(reportId)).data;
      }
      function validReply(data) {
        return data.keys().hasOnly(['report_id', 'reporter_id', 'sender_id', 'sender_role', 'message', 'created_at'])
          && data.keys().hasAll(['report_id', 'reporter_id', 'sender_id', 'sender_role', 'message', 'created_at'])
          && data.report_id is string
          && exists(/databases/$(database)/documents/Reports/$(data.report_id))
          // A resolved report is closed: the reporter sends a new report, or an admin reopens this one first.
          && reportOf(data.report_id).status != 'resolved'
          // A copy of the report's reporter, so the reporter's app reads all its replies with one query (no index).
          && data.reporter_id == reportOf(data.report_id).reporter_id
          && data.sender_id == request.auth.uid
          // An admin replies to any report; the reporter only to their own.
          && ((data.sender_role == 'admin' && isAdmin())
              || (data.sender_role == 'reporter' && data.reporter_id == request.auth.uid))
          && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
          && data.created_at == request.time;
      }

      // The same people who can read the report: its reporter and admins.
      allow read: if signedIn() && (resource.data.reporter_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && validReply(request.resource.data);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ admin access log (D58)
    // "Admin_Access_Log/<bookingId>_<adminUid>": the record of one admin opening one reported consultation (its chat and the
    // doctor's notes) to investigate a conduct report. It is the key that opens them (adminMayReview), so an admin cannot
    // read them without leaving this record. Admins only; it is never changed except to count another opening, and never
    // deleted, so it answers "which admin looked at this conversation, and when?".
    match /Admin_Access_Log/{logId} {
      // The report is a conduct report one of the two people on this booking filed about the other.
      function reportOnBooking(data) {
        return data.report_id in [conductReportId(data.booking_id, bookingData(data.booking_id).patient_id),
                                  conductReportId(data.booking_id, bookingData(data.booking_id).provider_id)]
          && exists(/databases/$(database)/documents/Reports/$(data.report_id));
      }
      allow read: if isAdmin();
      // The first opening: under the admin's own uid and their name as it is on their Admins record, at the server's time.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['admin_id', 'admin_name', 'booking_id', 'report_id', 'first_opened_at', 'last_opened_at', 'open_count'])
        && request.resource.data.keys().hasAll(['admin_id', 'admin_name', 'booking_id', 'report_id', 'first_opened_at', 'last_opened_at', 'open_count'])
        && request.resource.data.admin_id == request.auth.uid
        && request.resource.data.admin_name == get(/databases/$(database)/documents/Admins/$(request.auth.uid)).data.get('full_name', '')
        && request.resource.data.booking_id is string
        && logId == request.resource.data.booking_id + '_' + request.auth.uid
        && reportOnBooking(request.resource.data)
        && request.resource.data.first_opened_at == request.time
        && request.resource.data.last_opened_at == request.time
        && request.resource.data.open_count == 1;
      // Each later opening by the same admin: one more count and the time. It may name the other side's report, if both
      // reported each other. Who, which booking and when it was first opened never change.
      allow update: if isAdmin() && resource.data.admin_id == request.auth.uid
        && changedKeys().hasOnly(['report_id', 'last_opened_at', 'open_count'])
        && reportOnBooking(request.resource.data)
        && request.resource.data.last_opened_at == request.time
        && request.resource.data.open_count == resource.data.open_count + 1;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ gamification

    match /Gamification/{userId} {
      // Streak/points are readable by the owner and by admins (admin "View Award Points").
      allow read: if isUser(userId) || isAdmin();
      // The doc ID is the patient's UID, and you can only write your own stats.
      allow create, update: if isUser(userId) && request.resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    match /Badges/{badgeId} {
      // The badge catalogue is public to signed-in users (the rewards screen lists it).
      allow read: if signedIn();
      // Only admins define badges.
      allow write: if isAdmin();
    }

    match /User_Badges/{docId} {
      // You see your own earned badges; admins see all.
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // A badge can only be granted to yourself, and never edited or removed afterwards.
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ subscriptions

    match /Subscription_Plans/{planId} {
      // Plans and prices are public to signed-in users so they can compare them.
      allow read: if signedIn();
      // Only admins manage plans (module 12, admin side).
      allow write: if isAdmin();
    }

    match /Subscriptions/{subscriptionId} {
      // You see your own subscription; admins see all (premium subscribers list).
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // You subscribe only for yourself, to a real paid plan, on the plan's real terms (see validNewSubscription above).
      // Payment is mocked in the prototype, so it starts active.
      allow create: if validNewSubscription();
      // The only change an owner can make is cancelling.
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
                    && changedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }

    // ------------------------------------------------------------------ AI data (written ONLY by the Cloud Functions)
    // The functions use the Admin SDK, which bypasses these rules. Clients can read their own results but can never
    // write them, so nobody can forge suggestions or scans to get around the Free plan's daily limits (D1).

    // The server's daily usage counters (D20): how many AI suggestions and label scans each person, and everyone together,
    // used today. Nobody can touch them from an app, not even an admin, so a person cannot reset their own count. (This
    // block is only here to say so out loud: anything not matched in this file is denied anyway.)
    match /Usage_Counters/{counterId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------ family alerts (D45)

    // Up to two family members the server texts when the patient logs a critical reading. Private: only the patient.
    // (The server reads it with its own access.) Kept off Users on purpose, because a booked doctor can read Users.
    match /Emergency_Contacts/{uid} {
      // A name, an optional relationship, and a Philippine mobile number in +639XXXXXXXXX form.
      function validContact(contact) {
        return contact is map
          && contact.keys().hasOnly(['name', 'relationship', 'phone'])
          && contact.keys().hasAll(['name', 'phone'])
          && contact.name is string && contact.name.size() >= 1 && contact.name.size() <= 60
          && contact.get('relationship', '') is string && contact.get('relationship', '').size() <= 30
          && contact.phone is string && contact.phone.matches('[+]639[0-9]{9}');
      }
      function validContacts(data) {
        return data.keys().hasOnly(['user_id', 'contacts', 'updated_at'])
          && data.user_id == uid
          && data.contacts is list && data.contacts.size() <= 2
          && (data.contacts.size() < 1 || validContact(data.contacts[0]))
          && (data.contacts.size() < 2 || (validContact(data.contacts[1]) && data.contacts[1].phone != data.contacts[0].phone))
          && data.updated_at == request.time;
      }
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid) && validContacts(request.resource.data);
    }

    // The outcome of each family alert, one per reading (D45). Written only by the server. The patient reads their own
    // (the result screen shows "We texted your family"); reading one that does not exist yet is allowed so the screen
    // can wait for it. It holds no phone number and no message.
    match /Family_Alerts/{logId} {
      allow read: if signedIn() && (resource == null || resource.data.patient_id == request.auth.uid);
      allow write: if false;
    }

    match /Food_Database/{foodId} {
      // The Filipino food/GI list grounds the AI prompts and is readable by signed-in users.
      allow read: if signedIn();
      // Only admins add, edit or hide foods (admin Content page, UT-A008-UT-A010). Glycemic index is a
      // percentile-style 0-100 scale; calories cannot be negative.
      allow create, update: if isAdmin()
                    && request.resource.data.food_name is string && request.resource.data.food_name.size() > 0
                    && request.resource.data.glycemic_index is number
                    && request.resource.data.glycemic_index >= 0 && request.resource.data.glycemic_index <= 100
                    && request.resource.data.calories is number && request.resource.data.calories >= 0
                    && request.resource.data.status in ['active', 'hidden'];
      allow delete: if isAdmin();
    }

    match /AI_Suggestions/{suggestionId} {
      // A person's generated suggestions are private to them (and admins for reports).
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // Created only by the generateRecommendations Cloud Function (Admin SDK), never by an app.
      allow create, update, delete: if false;
    }

    match /AI_Suggestions_Foods/{docId} {
      // A link row is visible only to the owner of the suggestion it points to; the function creates it.
      allow read: if signedIn() && (
        get(/databases/$(database)/documents/AI_Suggestions/$(resource.data.suggestion_id)).data.user_id == request.auth.uid
        || isAdmin());
      allow create, update, delete: if false;
    }

    match /Nutrition_Scans/{scanId} {
      // Scan results are private to the person who scanned (and admins for reports).
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // Created only by the analyzeLabel Cloud Function (Admin SDK), never by an app.
      allow create, update, delete: if false;
    }

    match /App_Pins/{userId} {
      // The app PIN belongs to the account (DECISIONS.md D53, amends D42). It holds only a random salt and a salted
      // SHA-256 hash of the 6-digit PIN, never the PIN. A 6-digit PIN has only a million possibilities, so the hash
      // could be guessed if it leaked: ONLY the owner may read or write it. Not doctors, not admins (no isAdmin() here).
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
                    && request.resource.data.keys().hasOnly(['salt', 'hash', 'failed_attempts', 'updated_at'])
                    && request.resource.data.keys().hasAll(['salt', 'hash', 'failed_attempts', 'updated_at'])
                    && request.resource.data.salt is string && request.resource.data.salt.size() == 32
                    && request.resource.data.hash is string && request.resource.data.hash.size() == 64
                    && request.resource.data.failed_attempts is int
                    && request.resource.data.failed_attempts >= 0 && request.resource.data.failed_attempts <= 5
                    && request.resource.data.updated_at == request.time;
    }
  }
}
