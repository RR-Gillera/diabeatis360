# ---- Secrets: never commit these (Diabeatis360) ----
.env
.env.*
!.env.example
serviceAccountKey*.json
*-firebase-adminsdk-*.json

# ---- Firebase CLI local files ----
.firebase/
firebase-debug.log*
firestore-debug.log
ui-debug.log

# ---- Node ----
node_modules/

# ---- Cloud Functions secrets/config (the Gemini key is set with `firebase functions:secrets:set`, never in a file) ----
functions/.secret.local
functions/.env
functions/.env.*

# QA evidence recordings (screen videos are large; screenshots and reports stay in git)
docs/reports/qa-*/**/video/
docs/reports/qa-*/**/*.mp4
docs/reports/qa-*/**/*.mkv

# Local QA tooling (Playwright for QA runs); not part of either app
qa-tools/

# The manuscript (Capstone 1 and 2 .docx files): 50+ MB each, so it is kept in Google Drive, not in git
DIABEATIS360 CAPSTONE PROJECT *.docx

# Local Firebase emulator export used for QA runs (firebase emulators:exec --import ./qa-emulator-data); test data, not source
qa-emulator-data/
