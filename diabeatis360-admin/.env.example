# Copy this file to `.env` and fill in the real values from the Firebase console
# (Project settings > General > Your apps). Share the real .env privately, never commit it.
# Anything prefixed VITE_ is visible in the browser bundle: configuration only, no secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set to true to run the panel against the local Firebase emulators (firebase emulators:start)
# instead of the real project. Leave unset for normal use.
# VITE_USE_EMULATORS=true
