# Copy this file to `.env` and fill in the real values from the Firebase console
# (Project settings > General > Your apps). Share the real .env privately, never commit it.
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and is NOT secret.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# There is deliberately NO Gemini key here. DECISIONS.md D1: the app calls Firebase Cloud Functions,
# and only the functions hold the key (as a Functions secret). Never add EXPO_PUBLIC_GEMINI_API_KEY.
