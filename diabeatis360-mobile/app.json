{
  "expo": {
    "name": "Diabeatis360",
    "slug": "diabeatis360-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "diabeatis360mobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.diabeatis360.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Diabeatis360 to use the camera to scan nutrition labels, take your profile photo and join video consultations.",
          "microphonePermission": "Allow Diabeatis360 to use the microphone so your doctor can hear you during video consultations.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Diabeatis360 to use a photo from your library as your profile photo.",
          "cameraPermission": "Allow Diabeatis360 to use the camera to scan nutrition labels, take your profile photo and join video consultations.",
          "microphonePermission": "Allow Diabeatis360 to use the microphone so your doctor can hear you during video consultations."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#629C2C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "767c82a9-35d4-4d2a-a326-2f116edd5637"
      }
    },
    "owner": "diabeatis360",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/767c82a9-35d4-4d2a-a326-2f116edd5637"
    }
  }
}
